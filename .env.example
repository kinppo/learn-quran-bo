# Vercel and local browsers use the same-origin API route.
# On Vercel, vercel.json forwards it to the VPS. Do not set this to the HTTP IP.
VITE_API_URL=/api/v1
API_PROXY_TARGET=http://127.0.0.1:18000

# Optional local Docker settings; not used by Vercel.
WEB_PORT=5173
API_UPSTREAM=http://host.docker.internal:18000
